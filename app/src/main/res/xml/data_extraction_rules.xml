<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing in this app is worth moving off the device: the only persisted
    state is the user's own settings strings. allowBackup=false covers Android
    11 and below; these rules cover Android 12+ cloud backup and device
    to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
